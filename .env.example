# Cerebro de Claude — configuración opcional.
# Copia este archivo a .env. El servidor lo relee solo: no hace falta reiniciar.
#
# El cerebro conversa y audita usando tu Claude Code instalado (comando `claude`), sin API keys.
# La única clave es la de la voz: sin ella, el cerebro contesta por escrito.

# --- Voz (Fish Audio) -------------------------------------------------------
# Crea tu clave en https://fish.audio/app/api-keys
FISH_API_KEY=
# ID de la voz (32 caracteres). Elige una en https://fish.audio/discovery o clona la tuya.
# Vacío = voz por defecto de Fish.
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
# normal | balanced | low
FISH_LATENCY=balanced
VOICE_SPEED=1.0

# --- Claude ------------------------------------------------------------------
# Modelo que piensa las respuestas habladas: sonnet (recomendado, ~2 s para empezar) | haiku | opus
VOICE_CLAUDE_MODEL=sonnet
# Modelo para Auditar / Mejorar memoria. Vacío = el que usa tu Claude Code.
CLAUDE_MODEL=
